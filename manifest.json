{
  "manifest_version": 3,
  "name": "ClickImage",
  "version": "1.2.2",
  "description": "Selecione uma imagem da página e baixe seu arquivo original.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "ClickImage — selecionar imagem", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
