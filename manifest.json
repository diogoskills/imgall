{
  "manifest_version": 3,
  "name": "ClickImage",
  "version": "2.6.0",
  "description": "Selecione uma imagem da página e baixe seu arquivo original.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ClickImage — selecionar imagem",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "panel.html"
  }
}
